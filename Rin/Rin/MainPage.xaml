<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Rin.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pagemodels="clr-namespace:Rin.PageModels"
    x:DataType="pagemodels:MainPageModel"
    Shell.NavBarIsVisible="False">

    <ScrollView Margin="15,40" Orientation="Vertical">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <Grid.Resources>
                <Style x:Key="ResultLabel" TargetType="Label">
                    <Setter Property="TextColor" Value="{StaticResource Primary}" />
                    <Setter Property="FontSize" Value="70" />
                    <Setter Property="TextColor" Value="{StaticResource Primary}" />
                    <Setter Property="VerticalOptions" Value="Center" />
                    <Setter Property="HorizontalOptions" Value="Center" />
                </Style>

                <Style x:Key="EntryLabels" TargetType="Label">
                    <Setter Property="TextColor" Value="Grey" />
                </Style>
            </Grid.Resources>

            <!--  title  -->
            <Label
                Grid.Row="0"
                Margin="0,0,0,40"
                FontSize="32"
                Text="Find distance" />

            <!--  first location group  -->
            <VerticalStackLayout
                Grid.Row="1"
                Margin="0,0,0,40"
                Spacing="4">
                <SearchBar
                    x:Name="SearchBarFirst"
                    Placeholder="First location"
                    TextChanged="SearchBarFirst_TextChanged" />
            </VerticalStackLayout>

            <!--  second location group  -->
            <VerticalStackLayout Grid.Row="2" Spacing="4">
                <SearchBar
                    x:Name="SearchBarSecond"
                    Placeholder="Second location"
                    TextChanged="SearchBarSecond_TextChanged" />
            </VerticalStackLayout>

            <!--  result  -->
            <Label
                Grid.Row="3"
                IsVisible="{Binding InitialLoad}"
                Style="{StaticResource ResultLabel}"
                Text="{Binding TotalDistance, StringFormat='{0} Km'}" />

            <!--  calc distance btn  -->
            <Button
                Grid.Row="4"
                Command="{Binding FindDistanceBetweenCommand}"
                Text="Find"
                VerticalOptions="End" />
        </Grid>
    </ScrollView>

</ContentPage>
